<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sparkplug B / UNS governance lab — built on Eclipse Tahu 1.0.14 (compiled for Java 1.8,
  consumable from Java 17+) + Eclipse Paho + Eclipse Milo (OPC UA client) + kafka-clients.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.krillin.sparkplug</groupId>
  <artifactId>sparkplug-lab</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Sparkplug UNS Governance Lab</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tahu.version>1.0.14</tahu.version>
  </properties>

  <dependencies>
    <!-- Sparkplug B encode/decode + model (Metric, SparkplugBPayload, UDT/Template, StatePayload) -->
    <dependency>
      <groupId>org.eclipse.tahu</groupId>
      <artifactId>tahu-core</artifactId>
      <version>${tahu.version}</version>
    </dependency>
    <!-- Edge node session machinery (bdSeq mgr, MQTT client wrapper, MetricHandler) -->
    <dependency>
      <groupId>org.eclipse.tahu</groupId>
      <artifactId>tahu-edge</artifactId>
      <version>${tahu.version}</version>
    </dependency>
    <!-- Host application machinery (STATE, rebirth, sequence-reorder, tag model) -->
    <dependency>
      <groupId>org.eclipse.tahu</groupId>
      <artifactId>tahu-host</artifactId>
      <version>${tahu.version}</version>
    </dependency>

    <!-- OPC UA client (Milo sdk-client) — southbound: browse/read an OPC UA server,
         bridge its information model into Sparkplug UDTs. -->
    <dependency>
      <groupId>org.eclipse.milo</groupId>
      <artifactId>milo-sdk-client</artifactId>
      <version>1.0.0</version>
    </dependency>

    <!-- logging: Tahu uses slf4j + pulls logback-core 1.3.14 transitively.
         Pin logback-classic to the SAME 1.3.x line (classic/core must match) — verified via mvn dependency:resolve.
         Our own src/main/resources/logback.xml keeps root=INFO. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.3.14</version>
    </dependency>

    <!-- Schema registry: data-contract JSON (de)serialization. Declared directly rather than
         relying on transitive versions; core/annotations pinned too so Tahu's transitive 2.13.4
         doesn't win by nearest-wins resolution. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>2.17.2</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.17.2</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
    <!-- Kafka producer/consumer/admin for the UNS→Kafka bridge. -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.7.1</version>
    </dependency>
    <!-- JUnit 5 for the pure-logic test suite. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- run demos: mvn exec:java -Dexec.mainClass=dev.krillin.sparkplug.SessionDemo -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
